# The same OAuth client is valid against both upstream instances (production and
# acceptance), so switching environments in the UI needs no extra secrets here.
IMPROVE_CLIENT_ID=your_client_id_here
IMPROVE_CLIENT_SECRET=your_client_secret_here

# Optional — point either environment at a different upstream. compose.yaml falls
# back to the values below when these are unset, so leave them out to use the
# defaults. The hosts shown in the UI are not affected (see TECH_DEBT.md).
#IMPROVE_API_BASE_URL=https://api.360yield.com
#IMPROVE_ACCEPTANCE_API_BASE_URL=https://api.360yielddev.com

# Optional — enables the Google Maps basemap on the DOOH Metadata map tab.
# Leave blank to offer only OpenStreetMap (the Google option renders disabled).
# This is a browser key baked into the JS bundle, so restrict it by HTTP
# referrer and API in the Google Cloud console.
GOOGLE_MAPS_API_KEY=
# Optional — a Cloud Map ID (required by Google's AdvancedMarker).
# Defaults to Google's DEMO_MAP_ID when blank.
GOOGLE_MAPS_MAP_ID=
